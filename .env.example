# ─────────────────────────────────────────────────────────────────────────────
# 🧾 BILLORA OS — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. DATABASE & PERSISTENCE ───────────────────────────────────────────────
# Local SQLite default:
DATABASE_URL="file:./prisma/dev.db"

# Production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/invoice_db?schema=public"

# ─── 2. AUTHENTICATION & SECURITY ────────────────────────────────────────────
# Generate a strong 32+ character random string for production session signing
AUTH_SECRET="replace-with-a-secure-random-32-char-secret"

# Node environment & application URLs
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Billora"

# ─── 3. PAYMENT GATEWAY (RAZORPAY & UPI) ─────────────────────────────────────
# Razorpay API Credentials (optional: sandbox mode fallback active if empty)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ─── 4. AI AGENTS & OCR VISION SCANNER ──────────────────────────────────────
# OpenAI API key (for GPT-4o OCR bill scanning)
OPENAI_API_KEY="sk-proj-..."

# Google Gemini API key (for NLP business autopilot)
GEMINI_API_KEY="AIzaSy..."

# ─── 5. WHATSAPP BUSINESS CLOUD API (META) ──────────────────────────────────
# Meta WhatsApp Cloud API credentials
WHATSAPP_API_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_PHONE_ID="1234567890"
WHATSAPP_ACCESS_TOKEN="EAA..."

# ─── 6. TRANSACTIONAL EMAIL & PASSWORD RECOVERY ──────────────────────────────
# Resend API Key for digital invoices & password reset emails
RESEND_API_KEY="re_..."
PASSWORD_RESET_FROM="Billora Security <billing@yourdomain.com>"
PASSWORD_RESET_LOG="true"

# ─── 7. GOOGLE OAUTH (OPTIONAL SOCIAL SIGN-IN) ───────────────────────────────
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
