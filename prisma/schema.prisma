generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum DocumentType {
  SALE
  ESTIMATE
  PROFORMA
  SALE_ORDER
  CREDIT_NOTE
  DELIVERY_CHALLAN
  PURCHASE
  DEBIT_NOTE
  PURCHASE_ORDER
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CHEQUE
  CARD
}

enum AccountType {
  CASH
  BANK
}

enum UserRole {
  ADMIN
  STAFF
  WAREHOUSE_CLERK
  CA_AUDITOR
  SALES_OPERATOR
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole     @default(ADMIN)
  totpSecret     String?
  totpEnabled    Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Organization {
  id            String           @id @default(cuid())
  name          String
  users         User[]
  profile       CompanyProfile?
  customers     Customer[]
  items         Item[]
  invoices      Invoice[]
  employees     Employee[]
  bankAccounts  BankAccount[]
  payments      Payment[]
  expenses      Expense[]
  numberSeries  NumberSeries[]
  ledgers       Ledger[]
  vouchers      JournalVoucher[]
  dpdpConsents  DpdpConsent[]
  auditLogs     AuditLog[]
  notifications Notification[]
  recurringInvoices RecurringInvoice[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum BusinessVertical {
  RETAIL_WHOLESALE
  PHARMACY
  SALON_CLINIC
  RESTAURANT
  GENERAL_SERVICES
  OTHER
}

model CompanyProfile {
  id                   String           @id @default(cuid())
  organizationId       String           @unique
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName          String           @default("")
  businessVertical     BusinessVertical @default(RETAIL_WHOLESALE)
  enableBatchExpiry    Boolean          @default(false)
  enableBarcodes       Boolean          @default(true)
  enableStaffCommission Boolean         @default(false)
  defaultItemType      ItemType         @default(PRODUCT)
  email                String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  zipCode              String?
  country              String?          @default("India")
  website              String?
  taxId                String?
  logoUrl              String?
  bankName             String?
  accountNumber        String?
  routingNumber        String?
  paymentTerms         String?
  invoicePrefix        String           @default("INV")
  nextInvoiceNumber    Int              @default(1)
  currency             String           @default("INR")
  defaultTaxRate       Float            @default(18)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model NumberSeries {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  prefix         String
  nextNumber     Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

model Customer {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String?
  taxId           String?
  notes           String?
  partyType       PartyType    @default(CUSTOMER)
  openingBalance  Float        @default(0)
  invoices        Invoice[]
  payments        Payment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, name])
}

model Item {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  hsn            String?
  unitPrice      Float
  estimatePrice  Float        @default(0)
  purchasePrice  Float        @default(0)
  unit           String?
  gstRate        Float        @default(18)
  itemType       ItemType     @default(PRODUCT)
  stockQty       Float        @default(0)
  minStock       Float        @default(0)
  isPublic       Boolean          @default(false)
  batches        InventoryBatch[]
  serialNumbers  SerialNumber[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
  @@index([isPublic])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceNumber  String
  documentType   DocumentType  @default(SALE)
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  companyName    String
  companyEmail   String?
  companyPhone   String?
  companyAddress String?
  companyCity    String?
  companyState   String?
  companyZip     String?
  companyCountry String?
  companyTaxId   String?
  notes          String?
  terms          String?
  placeOfSupply  String?
  isInterState   Boolean       @default(false)
  vehicleNumber  String?
  ewayBill       String?
  orderNumber    String?
  subtotal       Float         @default(0)
  taxRate        Float         @default(0)
  taxAmount      Float         @default(0)
  cgstAmount     Float         @default(0)
  sgstAmount     Float         @default(0)
  igstAmount     Float         @default(0)
  discount       Float         @default(0)
  total          Float         @default(0)
  paidAmount     Float         @default(0)
  items          InvoiceItem[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, documentType])
  @@index([customerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String?
  description String
  hsn         String?
  unit        String?
  quantity    Float
  unitPrice   Float
  gstRate     Float   @default(0)
  amount      Float
  sortOrder   Int     @default(0)
}

model BankAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  accountType    AccountType  @default(CASH)
  accountNumber  String?
  ifsc           String?
  openingBalance Float        @default(0)
  payments       Payment[]
  expenses       Expense[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
}

model Payment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  direction      PaymentDirection
  partyId        String?
  party          Customer?         @relation(fields: [partyId], references: [id], onDelete: SetNull)
  invoiceId      String?
  invoice        Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  bankAccountId  String
  bankAccount    BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  amount         Float
  date           DateTime
  mode           PaymentMode       @default(CASH)
  reference      String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, direction, date])
}

model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  category       String
  description    String?
  amount         Float
  gstRate        Float        @default(0)
  taxAmount      Float        @default(0)
  date           DateTime
  bankAccountId  String
  bankAccount    BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, date])
}

model Employee {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  position       String?
  hourlyRate     Float
  overtimeRate   Float
  attendance     AttendanceRecord[]
  payrolls       PayrollRecord[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, name])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  hoursWorked Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

// ─── Tally-Style Accounting Module ───────────────────────────────────────────

enum LedgerGroup {
  // Assets
  CASH_IN_HAND
  BANK_ACCOUNTS
  FIXED_ASSETS
  CURRENT_ASSETS
  LOANS_ADVANCES_ASSET
  // Liabilities
  SUNDRY_CREDITORS
  CURRENT_LIABILITIES
  LOANS_LIABILITY
  CAPITAL_ACCOUNT
  RESERVES_SURPLUS
  // Income
  SALES_ACCOUNTS
  DIRECT_INCOME
  INDIRECT_INCOME
  // Expenses
  PURCHASE_ACCOUNTS
  DIRECT_EXPENSES
  INDIRECT_EXPENSES
  // Tax
  DUTIES_TAXES
  // Other
  SUNDRY_DEBTORS
  BRANCH_DIVISIONS
}

enum BalanceType {
  DR
  CR
}

enum VoucherType {
  PAYMENT    // F5
  RECEIPT    // F6
  JOURNAL    // F7
  CONTRA     // F4
  SALES      // F8
  PURCHASE   // F9
  DEBIT_NOTE
  CREDIT_NOTE
}

model Ledger {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  group           LedgerGroup
  openingBalance  Float         @default(0)
  openingType     BalanceType   @default(DR)
  isSystem        Boolean       @default(false)  // system-seeded ledgers (Cash, Sales, etc.)
  notes           String?
  entries         JournalEntry[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, group])
}

model JournalVoucher {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voucherNumber  String
  voucherType    VoucherType    @default(JOURNAL)
  date           DateTime
  narration      String?
  reference      String?
  isAltered      Boolean        @default(false)
  entries        JournalEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, voucherNumber])
  @@index([organizationId, date])
  @@index([organizationId, voucherType])
}

model JournalEntry {
  id        String         @id @default(cuid())
  voucherId String
  voucher   JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId  String
  ledger    Ledger         @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  type      BalanceType    // DR or CR
  amount    Float
  createdAt DateTime       @default(now())

  @@index([voucherId])
  @@index([ledgerId])
}

model DpdpConsent {
  id            String       @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType    String       // "CUSTOMER" | "EMPLOYEE"
  entityId      String
  entityName    String
  contact       String
  purpose       String       // "TRANSACTIONAL_INVOICES", etc.
  status        String       // "GRANTED" | "WITHDRAWN" | "EXPIRED"
  grantedAt     DateTime
  channel       String
  noticeVersion String
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([organizationId])
  @@index([entityId])
}

model AuditLog {
  id            String       @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId        String?
  action        String       // "CREATE", "UPDATE", "DELETE"
  entity        String       // "Invoice", "Ledger", etc.
  entityId      String
  changes       String?      // JSON diff or description
  timestamp     DateTime     @default(now())

  @@index([organizationId])
  @@index([timestamp])
}

model Notification {
  id            String       @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId        String?
  type          String       // "PAYMENT_DUE", "INVOICE_SENT", "LOW_STOCK"
  title         String
  message       String
  read          Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([organizationId])
  @@index([read])
}

model InventoryBatch {
  id            String    @id @default(cuid())
  itemId        String
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNumber   String
  expiryDate    DateTime?
  quantity      Float
  costPrice     Float     @default(0)
  dateReceived  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([itemId, batchNumber])
  @@index([itemId])
}

model SerialNumber {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  serialNumber  String
  status        String   @default("AVAILABLE")
  dateAdded     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([itemId, serialNumber])
  @@index([itemId])
}

model RecurringInvoice {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceTemplateId  String?
  frequency          String       // "DAILY", "WEEKLY", "MONTHLY", "QUARTERLY", "YEARLY"
  startDate          DateTime
  endDate            DateTime?
  lastGeneratedAt    DateTime?
  nextGenerationDate DateTime
  status             String       @default("ACTIVE")
  autoEmail          Boolean      @default(true)
  autoWhatsApp       Boolean      @default(false)
  reminderDaysBefore Int          @default(3)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
  @@index([nextGenerationDate])
}

model PayrollRecord {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month         DateTime
  baseSalary    Float
  overtimePay   Float    @default(0)
  grossSalary   Float
  pfDeduction   Float    @default(0)
  esiDeduction  Float    @default(0)
  taxDeduction  Float    @default(0)
  netSalary     Float
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
}

